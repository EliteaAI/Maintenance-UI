{
  "name": "maintenance",
  "private": true,
  "version": "0.0.5",
  "type": "module",
  "homepage": "./elitea_ui/",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:watch": "vite build --watch",
    "preview": "vite preview",
    "lint_disabled": "eslint src --ext js,jsx --report-unused-disable-directives",
    "lint": "eslint .",
    "format": "prettier --write \"**/**/*.{js,jsx,md}\"",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "test": "cd tests && npm run test",
    "test:dev": "cd tests && npm run test:dev",
    "test:install": "cd tests && npm install",
    "test:debug": "cd tests && npm run debug",
    "commit": "git-cz --no-verify"
  },
  "lint-staged": {
    "*.{js,jsx}": [
      "eslint --fix",
      "prettier --write"
    ]
  },
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.0",
    "@mui/material": "^7.0.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.5.0",
    "vite-plugin-svgr": "^4.3.0"
  },
  "devDependencies": {
    "@rollup/plugin-inject": "^5.0.5",
    "@vitejs/plugin-react": "^4.3.4",
    "eslint": "^9.24.0",
    "lint-staged": "^16.2.7",
    "prettier": "^3.6.2",
    "vite": "^6.2.6",
    "vite-plugin-singlefile": "^2.3.0"
  },
  "author": {
    "email": "artem_dubrovskii@epam.com",
    "name": "Artem Dubrovskiy"
  }
}